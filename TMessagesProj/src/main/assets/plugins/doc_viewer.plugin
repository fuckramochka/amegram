# ----------------------------------------------------------------- Colors & Theming
def argb(a, r, g, b):
    v = (a << 24) | (r << 16) | (g << 8) | b
    return v - 0x100000000 if v >= 0x80000000 else v


def hex_color(val):
    return "#%06x" % (val & 0xFFFFFF)


def get_telegram_theme():
    """Считывает цвета активной темы Yumigram напрямую из Theme.java."""
    try:
        TgTheme = jclass("org.telegram.ui.ActionBar.Theme")
        is_dark = bool(TgTheme.isCurrentThemeDark())
        bg = int(TgTheme.getColor(TgTheme.key_windowBackgroundWhite))
        bg_card = int(TgTheme.getColor(TgTheme.key_windowBackgroundGray))
        fg = int(TgTheme.getColor(TgTheme.key_windowBackgroundWhiteBlackText))
        sub = int(TgTheme.getColor(TgTheme.key_windowBackgroundWhiteGrayText2))
        accent = int(TgTheme.getColor(TgTheme.key_featuredStickers_addButton))
        divider = int(TgTheme.getColor(TgTheme.key_divider))
        bar_bg = int(TgTheme.getColor(TgTheme.key_actionBarDefault))
        bar_fg = int(TgTheme.getColor(TgTheme.key_actionBarDefaultTitle))
        pill_bg = argb(220, 28, 28, 36) if is_dark else argb(230, 240, 240, 245)
        hit_bg = argb(255, 230, 150, 40) if is_dark else argb(255, 255, 210, 80)
        cur_bg = argb(255, 255, 90, 0) if is_dark else argb(255, 255, 120, 0)
        return {
            "dark": is_dark, "bg": bg, "bg_card": bg_card, "fg": fg,
            "sub": sub, "accent": accent, "divider": divider,
            "bar_bg": bar_bg, "bar_fg": bar_fg, "pill_bg": pill_bg,
            "hit_bg": hit_bg, "cur_bg": cur_bg,
            "css_bg": hex_color(bg), "css_fg": hex_color(fg),
            "css_alt": hex_color(bg_card), "css_accent": hex_color(accent)
        }
    except Exception as e:
        log("DocViewer: fallback to static dark theme: %s" % e)
        return {
            "dark": True, "bg": argb(255, 14, 14, 18), "bg_card": argb(255, 24, 24, 30),
            "fg": argb(255, 240, 240, 245), "sub": argb(255, 150, 152, 165),
            "accent": argb(255, 82, 136, 255), "divider": argb(255, 40, 40, 48),
            "bar_bg": argb(255, 20, 20, 26), "bar_fg": argb(255, 255, 255, 255),
            "pill_bg": argb(230, 32, 32, 42), "hit_bg": argb(255, 180, 130, 20),
            "cur_bg": argb(255, 230, 110, 0),
            "css_bg": "#0e0e12", "css_fg": "#f0f0f5", "css_alt": "#18181e", "css_accent": "#5288ff"
        }


