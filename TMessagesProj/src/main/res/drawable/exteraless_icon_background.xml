<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep Gothic Velvet background -->
    <path
        android:pathData="M 0,0 H 108 V 108 H 0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="46"
                android:gradientRadius="72">
                <item android:color="#FF2C173F" android:offset="0.0"/>
                <item android:color="#FF180D26" android:offset="0.55"/>
                <item android:color="#FF0C0614" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Halo soft ambient aura -->
    <path
        android:pathData="M 54,48 m -38,0 a 38,38 0 1,0 76,0 a 38,38 0 1,0 -76,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="48"
                android:gradientRadius="38">
                <item android:color="#59A855F7" android:offset="0.0"/>
                <item android:color="#00A855F7" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle celestial orbit ring -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="0.6"
        android:strokeAlpha="0.18"
        android:pathData="M 54,48 m -33,0 a 33,33 0 1,0 66,0 a 33,33 0 1,0 -66,0"/>
</vector>
